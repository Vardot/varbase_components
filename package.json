{
  "name": "varbase_components",
  "version": "2.0.0",
  "description": "This is the components handler module with components helper, theme switcher for components in Varbase.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Components",
    "Vartheme BS5"
  ],
  "author": "Vardot",
  "homepage": "https://www.drupal.org/project/varbase_components",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:firefox": "BROWSER=firefox node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:webkit": "BROWSER=webkit node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "generate-reports": "node ./node_modules/@vardot/varbase-e2e/bin/generate-reports.js"
  },
  "devDependencies": {
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-yml": "^1.15.0",
    "prettier": "^3.4.2"
  },
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "@vardot/varbase-e2e": "^2.0.8"
  },
  "resolutions": {
    "playwright-core": "1.60.0"
  }
}
