{
  "name": "varbase_components",
  "version": "2.0.0",
  "description": "This is the components handler module with components helper, theme switcher for components in Varbase.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Components",
    "Vartheme BS5"
  ],
  "author": "Vardot",
  "homepage": "https://www.drupal.org/project/varbase_components",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "devDependencies": {
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-yml": "^1.15.0",
    "prettier": "^3.4.2"
  },
  "packageManager": "yarn@4.9.3",
  "dependencies": {
    "@cucumber/cucumber": "10.0.1",
    "@cucumber/pretty-formatter": "1.0.0",
    "playwright": "1.60.0",
    "tsx": "4.22.1",
    "@vardot/varbase-e2e": "~2.0.1"
  },
  "resolutions": {
    "@cucumber/cucumber": "10.0.1",
    "playwright": "1.60.0",
    "playwright-core": "1.60.0"
  }
}
