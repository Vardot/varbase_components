{% stories ViewsViewGrid with {
  "title": "Organisms/View Grid",
  "parameters": {
    "componentSubtitle": "Bootstrap Grid component for a block, which uses Drupal Views.",
    "docs": {
      "description": {
        "component": "A Drupal View Block component rendered as a responsive Bootstrap grid layout. Each item in the view appears inside a column that is responsive at various breakpoints."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "rows": {
      "name": "Rows",
      "description": "An array of items. Each item is wrapped in a responsive column.",
      "control": "object",
      "defaultValue": []
    },
    "grid_utility_classes": {
      "name": "Grid Row Utility Classes",
      "description": "Use to add extra Bootstrap utility classes for the grid `row`. E.g. `row-cols-1 row-cols-sm-2 row-cols-md-4`. ( Do not add `grid`, or `row`).",
      "control": "object",
      "defaultValue": []
    },
    "column_utility_classes": {
      "name": "Column Utility Classes",
      "description": "Use to add extra Bootstrap utility classes for the column `col`. E.g. `gy-4 g-sm-4` or `mb-4`. ( Do not add `col` or `col-[*]`).",
      "control": "object",
      "defaultValue": []
    },
    "col_xs": {
      "name": "XS column width",
      "description": "Column width at xs and above.",
      "control": "select",
      "options": [
        "none", "col", "col-auto", "col-1", "col-2", "col-3", "col-4", "col-6", "col-12"
      ],
      "defaultValue": "col-12"
    },
    "col_sm": {
      "name": "SM column width",
      "description": "Column width at sm and above.",
      "control": "select",
      "options": [
        "none", "col-sm", "col-sm-auto", "col-sm-1", "col-sm-2", "col-sm-3", "col-sm-4", "col-sm-6", "col-sm-12"
      ],
      "defaultValue": "col-sm-6"
    },
    "col_md": {
      "name": "MD column width",
      "description": "Column width at md and above.",
      "control": "select",
      "options": [
        "none", "col-md", "col-md-auto", "col-md-1", "col-md-2", "col-md-3", "col-md-4", "col-md-6", "col-md-12"
      ],
      "defaultValue": "col-md-4"
    },
    "col_lg": {
      "name": "LG column width",
      "description": "Column width at lg and above.",
      "control": "select",
      "options": [
        "none", "col-lg", "col-lg-auto", "col-lg-1", "col-lg-2", "col-lg-3", "col-lg-4", "col-lg-6", "col-lg-12"
      ],
      "defaultValue": "none"
    },
    "col_xl": {
      "name": "XL column width",
      "description": "Column width at xl and above.",
      "control": "select",
      "options": [
        "none", "col-xl", "col-xl-auto", "col-xl-1", "col-xl-2", "col-xl-3", "col-xl-4", "col-xl-6", "col-xl-12"
      ],
      "defaultValue": "none"
    },
    "col_xxl": {
      "name": "XXL column width",
      "description": "Column width at xxl and above.",
      "control": "select",
      "options": [
        "none", "col-xxl", "col-xxl-auto", "col-xxl-1", "col-xxl-2", "col-xxl-3", "col-xxl-4", "col-xxl-6", "col-xxl-12"
      ],
      "defaultValue": "none"
    },
    "attributes": {
      "name": "Attributes",
      "description": "HTML attributes to apply to the outer grid container.",
      "control": "object",
      "defaultValue": {}
    }
  }
} %}

